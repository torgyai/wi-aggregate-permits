# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aggregate"
# Session signing key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Admin login (single operator account)
ADMIN_EMAIL="christian@stratexs.com"
ADMIN_PASSWORD=""
# Public base URL (used in proposal / intake / unsubscribe links)
APP_URL="http://localhost:3100"
# Bearer token Vercel Cron sends to /api/cron/*
CRON_SECRET=""

# --- AI (Claude) --------------------------------------------------------
# Without a key the app falls back to templates + keyword reply classification.
ANTHROPIC_API_KEY=""
# Optional override (default claude-opus-5)
AI_MODEL=""

# --- Outbound email -----------------------------------------------------
# MAIL_TRANSPORT = log | smtp | resend   ("log" never sends; safe default)
MAIL_TRANSPORT="log"
# SMTP (Google Workspace / Outlook / any inbox). Comma-separate several
# mailboxes as user:pass@host:port for rotation, or use the single fields.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_MAILBOXES=""
RESEND_API_KEY=""

# --- Reply ingestion (IMAP poll) -----------------------------------------
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
# Shared secret for POST /api/inbound/email (provider inbound webhooks)
INBOUND_SECRET=""

# --- Enrichment ---------------------------------------------------------
APOLLO_API_KEY=""

# --- Payments (optional; proposals still work without it) ----------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
