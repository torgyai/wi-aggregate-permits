{
  "name": "stratex-aggregate",
  "version": "0.1.0",
  "private": true,
  "description": "Wisconsin aggregate permitting autopilot: prospecting, outreach, closing and permit delivery for pits & quarries",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/**/*.test.ts src/lib/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "msha:sync": "tsx scripts/msha-sync.ts",
    "autopilot:tick": "tsx scripts/tick.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "next": "^14.2.15",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
